<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Camera -->
    <uses-permission
        android:name="android.permission.CAMERA" />

    <!-- Sensors -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS" />

    <!-- Activity recognition -->
    <uses-permission
        android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Notifications -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground Service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- Exact alarms -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Boot Completed -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Health Connect -->
    <uses-permission
        android:name="android.permission.health.READ_STEPS" />

    <uses-permission
        android:name="android.permission.health.READ_HEART_RATE" />

    <uses-permission
        android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Camera feature -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitTrack">

        <!-- ========================= -->
        <!-- Splash Activity -->
        <!-- ========================= -->
        <activity
            android:name=".activities.BodyMetricsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.WorkoutHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.WeeklyProgressActivity"
            android:exported="false"
            android:label="Weekly Progress"
            android:theme="@style/Theme.FitTrack" />

        <activity
            android:name=".activities.WorkoutStreakActivity"
            android:exported="false"
            android:label="Workout Streak"
            android:theme="@style/Theme.FitTrack" />

        <activity
            android:name=".activities.PersonalGoalsActivity"
            android:exported="false"
            android:label="Personal Goals"
            android:theme="@style/Theme.FitTrack" />

        <activity
            android:name=".activities.NutritionTrackerActivity"
            android:exported="false"
            android:label="Nutrition Tracker"
            android:theme="@style/Theme.FitTrack" />

        <activity
            android:name=".activities.UserGuideActivity"
            android:exported="false"
            android:label="User Guide"
            android:theme="@style/Theme.FitTrack" />

        <activity
            android:name=".activities.HealthSettingsActivity"
            android:exported="false"
            android:label="Health Settings"
            android:theme="@style/Theme.FitTrack" />


        <service
            android:name=".services.StepTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health" />

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FitTrack">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- ========================= -->
        <!-- Login -->
        <!-- ========================= -->

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Sign Up -->
        <!-- ========================= -->

        <activity
            android:name=".activities.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Forgot Password -->
        <!-- ========================= -->

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Health Connect Onboarding -->
        <!-- ========================= -->

        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="true"
            android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING"
            android:theme="@style/Theme.FitTrack">

            <intent-filter>

                <action
                    android:name="androidx.health.ACTION_SHOW_ONBOARDING" />

            </intent-filter>

        </activity>


        <!-- Android 14+ Health Connect onboarding -->

        <activity-alias
            android:name=".activities.UAndAboveOnboardingActivity"
            android:exported="true"
            android:targetActivity=".activities.OnboardingActivity"
            android:permission="android.permission.health.START_ONBOARDING">

            <intent-filter>

                <action
                    android:name="android.health.connect.action.SHOW_ONBOARDING" />

            </intent-filter>

        </activity-alias>


        <!-- ========================= -->
        <!-- Health Connect Permission Rationale -->
        <!-- ========================= -->

        <activity
            android:name=".activities.PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.FitTrack">

            <intent-filter>

                <action
                    android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />

            </intent-filter>

        </activity>


        <!-- Android 14+ Permission Usage -->

        <activity-alias
            android:name=".activities.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".activities.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">

            <intent-filter>

                <action
                    android:name="android.intent.action.VIEW_PERMISSION_USAGE" />

                <category
                    android:name="android.intent.category.HEALTH_PERMISSIONS" />

            </intent-filter>

        </activity-alias>


        <!-- ========================= -->
        <!-- Main Activity -->
        <!-- ========================= -->

        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.FitTrack"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================= -->
        <!-- Edit Profile -->
        <!-- ========================= -->

        <activity
            android:name=".activities.EditProfileActivity"
            android:exported="false"
            android:label="Edit Profile"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Body Analysis -->
        <!-- ========================= -->

        <activity
            android:name=".activities.BodyAnalysisActivity"
            android:exported="false"
            android:label="Body Analysis"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Posture Detection -->
        <!-- ========================= -->

        <activity
            android:name=".activities.PostureDetectionActivity"
            android:exported="false"
            android:label="Body Analysis"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Exercise Detail -->
        <!-- ========================= -->

        <activity
            android:name=".activities.ExerciseDetailActivity"
            android:exported="false"
            android:label="Exercise Detail"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Active Workout -->
        <!-- ========================= -->

        <activity
            android:name=".activities.WorkoutActiveActivity"
            android:exported="false"
            android:label="Workout Active"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- AI Assistant -->
        <!-- ========================= -->

        <activity
            android:name=".activities.AiAssistantActivity"
            android:exported="false"
            android:label="AI Assistant"
            android:theme="@style/Theme.FitTrack"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================= -->
        <!-- Reminders -->
        <!-- ========================= -->

        <activity
            android:name=".activities.RemindersActivity"
            android:exported="false"
            android:label="Reminders"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Settings -->
        <!-- ========================= -->

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- About Us -->
        <!-- ========================= -->

        <activity
            android:name=".activities.AboutUsActivity"
            android:exported="false"
            android:label="About Us"
            android:theme="@style/Theme.FitTrack" />


        <!-- ========================= -->
        <!-- Reminder Receiver -->
        <!-- ========================= -->

        <receiver
            android:name=".services.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- ========================= -->
        <!-- Boot Receiver -->
        <!-- ========================= -->

        <receiver
            android:name=".services.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>