<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_health_settings"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="Health Settings"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health &amp; Sync Preferences"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage health permissions, sync status, activity tracking sensors, and measurement unit preferences."
                android:textSize="14sp"
                android:textColor="@color/text_secondary_light"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Health Connect Integration & Last Sync Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Connect Integration"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FitTrack connects with Android Health Connect to read and sync step counts, heart rate readings, and active calorie expenditures."
                        android:textSize="14sp"
                        android:textColor="@color/text_primary_light"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_health_connect_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Connect SDK: Checking..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_health_connect_permissions_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Connect Access: Checking..."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/progress_empty"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Sync Status"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_last_sync_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Successful Sync: Never"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_last_sync_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Result: No sync performed yet"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/layout_sync_loading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp">

                        <ProgressBar
                            android:id="@+id/progress_sync"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sync in progress..."
                            android:textSize="13sp"
                            android:textColor="@color/primary_blue"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync_health_data"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Sync Health Data Now"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_blue"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Manage Health Permissions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage Health Permissions"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FitTrack requests permissions to read step sensor activity and Health Connect metrics."
                        android:textSize="14sp"
                        android:textColor="@color/text_primary_light"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_activity_permission_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Physical Activity Sensor: Checking..."
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_steps_permission_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Connect Steps: Checking..."
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_heart_rate_permission_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Connect Heart Rate: Checking..."
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_request_health_permissions"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Grant / Request Permissions"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/primary_blue"
                            app:cornerRadius="8dp"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_manage_permissions"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Open System Settings"
                            android:textSize="14sp"
                            android:textColor="@color/primary_blue"
                            app:strokeColor="@color/primary_blue"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Activity Sensor Tracking Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity Sensor Tracking"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_sensor_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hardware Step Sensor: Checking..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step Tracking Service: Checking..."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_toggle_service"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Start Step Service"
                        android:textSize="14sp"
                        android:textColor="@color/primary_blue"
                        app:strokeColor="@color/primary_blue"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Measurement Unit Preferences Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Measurement Unit Preferences"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose how weight and height are displayed throughout FitTrack."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginBottom="12dp" />

                    <!-- Weight Unit Preference -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight Unit"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light" />

                    <RadioGroup
                        android:id="@+id/rg_weight_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp">

                        <RadioButton
                            android:id="@+id/rb_weight_kg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kilograms (kg)"
                            android:textSize="14sp"
                            android:checked="true"
                            android:layout_marginEnd="16dp" />

                        <RadioButton
                            android:id="@+id/rb_weight_lbs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pounds (lbs)"
                            android:textSize="14sp" />
                    </RadioGroup>

                    <!-- Height Unit Preference -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Height Unit"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light" />

                    <RadioGroup
                        android:id="@+id/rg_height_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/rb_height_cm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Centimeters (cm)"
                            android:textSize="14sp"
                            android:checked="true"
                            android:layout_marginEnd="16dp" />

                        <RadioButton
                            android:id="@+id/rb_height_ft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Feet / Inches (ft)"
                            android:textSize="14sp" />
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Data Privacy Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Data Privacy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your health measurements and activity metrics are stored securely under your authenticated FitTrack account on Google Cloud Firestore and protected by private security rules. FitTrack does not collect extra sensitive data or share your health records with third parties."
                        android:textSize="14sp"
                        android:textColor="@color/text_primary_light"
                        android:lineSpacingMultiplier="1.2" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
