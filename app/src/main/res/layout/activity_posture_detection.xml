<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Live Camera Feed Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/posture_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Custom Skeleton Vector Tracking View Layer -->
    <com.fittrack.app.views.OverlayView
        android:id="@+id/skeleton_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_posture_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#A6000000"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btn_posture_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_person"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:importantForAccessibility="yes"
            android:contentDescription="Go Back"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Real-Time Posture Detection"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_exercise_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Exercise: Squats"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Real-Time AI Feedback Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#CC1E1E1E"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/accent_green"
        android:id="@+id/card_feedback">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE POSTURE FEEDBACK"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/text_posture_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correct Posture"
                android:textColor="@color/accent_green"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#44FFFFFF"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep your knees tracking over your feet and push hips back down."
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>