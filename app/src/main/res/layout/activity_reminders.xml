<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="Reminder Settings"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- =================================================== -->
            <!-- 1. WATER REMINDER CARD -->
            <!-- =================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Water Reminder 💧"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary_light"
                            android:layout_centerVertical="true"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_water_reminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <!-- Daily Progress Bar & Quick Log -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F0F8FF"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/tv_water_progress_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today: 0 / 8 glasses (0%)"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/water_blue"
                                android:layout_centerVertical="true"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_quick_add_water"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_alignParentEnd="true"
                                android:text="+ Log Water"
                                android:textSize="12sp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                app:cornerRadius="18dp"
                                android:backgroundTint="@color/water_blue"/>
                        </RelativeLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_water_daily"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp"
                            app:indicatorColor="@color/water_blue"
                            app:trackColor="@color/progress_empty"/>
                    </LinearLayout>

                    <!-- Goal & Interval Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:hint="Daily Goal (glasses)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_water_goal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="8"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:hint="Interval (hours)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_water_interval"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="2"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Active Hours Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_water_start_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Start: 08:00 AM"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_water_end_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="End: 10:00 PM"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"/>

                    </LinearLayout>

                    <!-- Save Water Settings Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_water_settings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Water Settings"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        android:backgroundTint="@color/water_blue"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- =================================================== -->
            <!-- 2. WORKOUT REMINDER CARD -->
            <!-- =================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workout Reminders 🏋️"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary_light"
                            android:layout_centerVertical="true"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_workout_schedule"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:text="+ Add Schedule"
                            android:textSize="12sp"
                            app:cornerRadius="18dp"
                            android:backgroundTint="@color/primary_blue"/>
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_workout_schedules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                    <TextView
                        android:id="@+id/tv_no_workout_schedules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No workout schedules set. Tap '+ Add Schedule' above to create one."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light"
                        android:gravity="center"
                        android:padding="12dp"
                        android:visibility="visible"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- =================================================== -->
            <!-- 3. MOVE & STRETCH CARD -->
            <!-- =================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Move &amp; Stretch Reminder 🚶"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary_light"
                            android:layout_centerVertical="true"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_move_reminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <!-- Interval Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Movement Break Interval (minutes)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_move_interval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="60"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Active Hours Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_move_start_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Start: 09:00 AM"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_move_end_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="End: 06:00 PM"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"/>

                    </LinearLayout>

                    <!-- Save Move Settings Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_move_settings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Move &amp; Stretch Settings"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        android:backgroundTint="@color/card_workout"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- =================================================== -->
            <!-- 4. SLEEP REMINDER CARD -->
            <!-- =================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sleep &amp; Wind-Down Reminder 🌙"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary_light"
                            android:layout_centerVertical="true"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_sleep_reminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <!-- Bedtime Picker Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sleep_bedtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Bedtime Target: 10:30 PM"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="8dp"/>

                    <!-- Wind-down Enable & Lead Time -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enable Wind-Down Alert"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary_light"
                            android:layout_centerVertical="true"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_winddown_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Wind-Down Alert (minutes before bedtime)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_winddown_lead_minutes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="30"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Save Sleep Settings Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_sleep_settings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Sleep Settings"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        android:backgroundTint="@color/card_ai"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- =================================================== -->
            <!-- 5. MEAL REMINDERS CARD -->
            <!-- =================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meal Reminders 🥗"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="16dp"/>

                    <!-- Breakfast Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_meal_breakfast_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:text="Breakfast: 08:00 AM"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_meal_breakfast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Lunch Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_meal_lunch_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:text="Lunch: 01:00 PM"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_meal_lunch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Dinner Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_meal_dinner_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:text="Dinner: 07:30 PM"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_meal_dinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Save Meals Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_meal_settings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Meal Reminders"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        android:backgroundTint="@color/card_diet"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- =================================================== -->
            <!-- 6. DAILY GOAL REMINDERS CARD -->
            <!-- =================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily Goal Reminders 🎯"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary_light"
                            android:layout_centerVertical="true"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_goal_reminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <!-- Goal Reminder Time Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_goal_reminder_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Reminder Time: 07:00 PM"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="8dp"/>

                    <!-- Checkboxes for Targets -->
                    <CheckBox
                        android:id="@+id/cb_remind_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Include Daily Step Goal Check"
                        android:checked="true"/>

                    <CheckBox
                        android:id="@+id/cb_remind_workout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Include Daily Workout Goal Check"
                        android:checked="true"
                        android:layout_marginBottom="16dp"/>

                    <!-- Save Goal Settings Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_goal_settings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Goal Reminders"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        android:backgroundTint="@color/card_steps"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
