<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background_light"
    android:padding="24dp">

    <!-- ACTIVE WORKOUT SCREEN -->
    <LinearLayout
        android:id="@+id/layout_active"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_active_exercise_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Exercise Workout"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● IN PROGRESS"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Circular Progress -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_timer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="12"
                android:progress="0"
                app:indicatorSize="220dp"
                app:trackThickness="10dp"
                app:indicatorColor="#2E7D32"
                app:trackColor="#DDE5E0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_timer_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set 1"
                    android:textColor="#212121"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR PROGRESS"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Workout Instructions -->
        <TextView
            android:id="@+id/tv_rep_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Complete 12 reps with controlled form."
            android:textColor="#757575"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="28dp" />

        <!-- Complete Set / Skip Rest -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finish_active"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Complete Set"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- WORKOUT COMPLETION SCREEN -->
    <LinearLayout
        android:id="@+id/layout_success"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- Success Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#E0F2E8"
            app:cardCornerRadius="50dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓"
                android:textColor="#2E7D32"
                android:textSize="56sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Completion Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Workout Complete!"
            android:textColor="#212121"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Completion Feedback -->
        <TextView
            android:id="@+id/tv_motivation_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Great work! You completed your workout."
            android:textColor="#757575"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="32dp" />

        <!-- Back to Library -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_to_library"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Back to Library"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="14dp" />

        <!-- View Workout History -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_history"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="View Workout History"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#2E7D32"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>