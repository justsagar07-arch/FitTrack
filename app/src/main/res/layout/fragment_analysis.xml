<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analysis &amp; Progress"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View weekly workout trends, physiological body metrics, and movement form insights."
            android:textSize="14sp"
            android:textColor="@color/text_secondary_light"
            android:layout_marginBottom="24dp"/>

        <!-- Weekly Progress Dashboard Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/image_weekly_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_workout"
                        app:tint="@color/primary_blue"
                        android:background="#E8EAF6"
                        android:padding="8dp"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/image_weekly_icon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:text="Weekly Progress Dashboard"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"/>
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Track completed workouts, view your 7-day progress bar chart, and review actual recorded session durations for the current week."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingMultiplier="1.2"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_weekly_progress"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="View Weekly Progress"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_workout"
                    app:iconGravity="textStart"
                    android:backgroundTint="@color/primary_blue"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Body Analysis Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/image_body_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_analysis"
                        app:tint="@color/primary_blue"
                        android:background="#E8EAF6"
                        android:padding="8dp"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/image_body_icon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:text="Advanced Body Analysis"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"/>
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scan your body physique to get rapid visual estimates of critical composition metrics, including Body Mass Index (BMI), Body Fat percentage, Lean Muscle Mass, and overall physique classification."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingMultiplier="1.2"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_body_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Start Body Analysis"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_analysis"
                    app:iconGravity="textStart"
                    android:backgroundTint="@color/primary_blue"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Posture Detection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/image_posture_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ai"
                        app:tint="@color/accent_green"
                        android:background="#E8F5E9"
                        android:padding="8dp"
                        android:importantForAccessibility="no"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/image_posture_icon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:text="Exercise Posture Detection"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"/>
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Track your movement forms in real-time during physical exercises like squats. The camera overlay plots virtual bone joints and provides dynamic vocal/visual posture alignment updates to prevent injury."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingMultiplier="1.2"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_exercise_posture_detection"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Exercise Posture Detection"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_ai"
                    app:iconGravity="textStart"
                    android:backgroundTint="@color/accent_green"
                    android:textColor="@color/black"
                    app:iconTint="@color/black"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
