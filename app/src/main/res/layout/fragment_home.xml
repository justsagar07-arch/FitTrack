<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background_light">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="16dp">


        <!-- ===================================================== -->
        <!-- GREETING -->
        <!-- ===================================================== -->

        <TextView

            android:id="@+id/tv_greeting"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/greeting_user"

            android:textColor="@color/text_primary_light"

            android:textSize="24sp"

            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- SUMMARY SECTION -->
        <!-- ===================================================== -->

        <LinearLayout

            android:id="@+id/layout_summary"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:orientation="horizontal">


            <!-- ================================================= -->
            <!-- STEPS -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginEnd="8dp"

                android:layout_weight="1"

                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center"

                    android:orientation="vertical"

                    android:padding="16dp">

                    <ImageView

                        android:layout_width="32dp"
                        android:layout_height="32dp"

                        android:src="@drawable/ic_steps"

                        app:tint="@color/card_steps" />

                    <TextView

                        android:id="@+id/tv_steps_value"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="0"

                        android:textColor="@color/text_primary_light"

                        android:textSize="18sp"

                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/steps_summary"

                        android:textColor="@color/text_secondary_light"

                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CALORIES -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginEnd="8dp"

                android:layout_weight="1"

                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center"

                    android:orientation="vertical"

                    android:padding="16dp">

                    <ImageView

                        android:layout_width="32dp"
                        android:layout_height="32dp"

                        android:src="@drawable/ic_calories"

                        app:tint="@color/card_calories" />

                    <TextView

                        android:id="@+id/tv_calories_value"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="0"

                        android:textColor="@color/text_primary_light"

                        android:textSize="18sp"

                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/calories_summary"

                        android:textColor="@color/text_secondary_light"

                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- HEART RATE -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center"

                    android:orientation="vertical"

                    android:padding="16dp">

                    <ImageView

                        android:layout_width="32dp"
                        android:layout_height="32dp"

                        android:src="@drawable/ic_heart"

                        app:tint="@color/card_heart" />

                    <TextView

                        android:id="@+id/tv_heart_rate_value"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="0"

                        android:textColor="@color/text_primary_light"

                        android:textSize="18sp"

                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/heart_rate_summary"

                        android:textColor="@color/text_secondary_light"

                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- WORKOUT SUMMARY DASHBOARD CARD -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_workout_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/iv_workout_summary_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_workout"
                        app:tint="@color/primary_blue"
                        android:importantForAccessibility="no"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/iv_workout_summary_icon"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"
                        android:text="Completed Workouts Summary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"/>

                    <ProgressBar
                        android:id="@+id/progress_home_workout_loading"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:visibility="gone"/>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_home_completed_workouts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Workouts"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"/>

                    <TextView
                        android:id="@+id/tv_home_completed_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="From your workout history"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_light"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_home_total_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Duration: -- min"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/card_steps"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp"/>

                <!-- Weekly Chart Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Progress (Mon - Sun)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light"
                    android:layout_marginBottom="8dp"/>

                <!-- 7 Day Bar Chart Layout -->
                <LinearLayout
                    android:id="@+id/layout_home_chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">

                    <!-- Monday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <TextView
                            android:id="@+id/tv_home_chart_mon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary_light"/>

                        <View
                            android:id="@+id/bar_home_mon"
                            android:layout_width="16dp"
                            android:layout_height="8dp"
                            android:background="@color/primary_blue"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_label_mon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="M"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary_light"/>
                    </LinearLayout>

                    <!-- Tuesday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <TextView
                            android:id="@+id/tv_home_chart_tue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary_light"/>

                        <View
                            android:id="@+id/bar_home_tue"
                            android:layout_width="16dp"
                            android:layout_height="8dp"
                            android:background="@color/primary_blue"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_label_tue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary_light"/>
                    </LinearLayout>

                    <!-- Wednesday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <TextView
                            android:id="@+id/tv_home_chart_wed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary_light"/>

                        <View
                            android:id="@+id/bar_home_wed"
                            android:layout_width="16dp"
                            android:layout_height="8dp"
                            android:background="@color/primary_blue"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_label_wed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="W"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary_light"/>
                    </LinearLayout>

                    <!-- Thursday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <TextView
                            android:id="@+id/tv_home_chart_thu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary_light"/>

                        <View
                            android:id="@+id/bar_home_thu"
                            android:layout_width="16dp"
                            android:layout_height="8dp"
                            android:background="@color/primary_blue"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_label_thu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary_light"/>
                    </LinearLayout>

                    <!-- Friday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <TextView
                            android:id="@+id/tv_home_chart_fri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary_light"/>

                        <View
                            android:id="@+id/bar_home_fri"
                            android:layout_width="16dp"
                            android:layout_height="8dp"
                            android:background="@color/primary_blue"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_label_fri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="F"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary_light"/>
                    </LinearLayout>

                    <!-- Saturday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <TextView
                            android:id="@+id/tv_home_chart_sat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary_light"/>

                        <View
                            android:id="@+id/bar_home_sat"
                            android:layout_width="16dp"
                            android:layout_height="8dp"
                            android:background="@color/primary_blue"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_label_sat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary_light"/>
                    </LinearLayout>

                    <!-- Sunday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <TextView
                            android:id="@+id/tv_home_chart_sun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary_light"/>

                        <View
                            android:id="@+id/bar_home_sun"
                            android:layout_width="16dp"
                            android:layout_height="8dp"
                            android:background="@color/primary_blue"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_label_sun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary_light"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================================================== -->
        <!-- WORKOUT STREAK CARD -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_workout_streak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_streak_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_workout"
                    app:tint="@color/card_steps"
                    android:importantForAccessibility="no"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/iv_streak_icon"
                    android:layout_marginStart="12dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/tv_streak_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Workout Streak"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"/>

                    <TextView
                        android:id="@+id/tv_streak_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View completed workout calendar &amp; streak"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/text_secondary_light"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:importantForAccessibility="no"/>

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- FEATURE GRID -->
        <!-- ===================================================== -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- ROW 1 -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">


                <!-- BODY ANALYSIS -->

                <com.google.android.material.card.MaterialCardView

                    android:id="@+id/card_body_analysis"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_margin="8dp"

                    android:layout_weight="1"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="20dp">

                        <ImageView

                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_analysis"

                            app:tint="@color/card_analysis" />

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="8dp"

                            android:text="@string/body_analysis"

                            android:textColor="@color/text_primary_light"

                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- AI ASSISTANT -->

                <com.google.android.material.card.MaterialCardView

                    android:id="@+id/card_ai_assistant"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_margin="8dp"

                    android:layout_weight="1"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="20dp">

                        <ImageView

                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_ai"

                            app:tint="@color/card_ai" />

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="8dp"

                            android:text="@string/ai_assistant"

                            android:textColor="@color/text_primary_light"

                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ROW 2 -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">


                <!-- EXERCISES -->

                <com.google.android.material.card.MaterialCardView

                    android:id="@+id/card_exercises"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_margin="8dp"

                    android:layout_weight="1"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="20dp">

                        <ImageView

                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_workout"

                            app:tint="@color/card_workout" />

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="8dp"

                            android:text="@string/exercises"

                            android:textColor="@color/text_primary_light"

                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- DIET PLAN -->

                <com.google.android.material.card.MaterialCardView

                    android:id="@+id/card_diet_plan"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_margin="8dp"

                    android:layout_weight="1"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="20dp">

                        <ImageView

                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_diet"

                            app:tint="@color/card_diet" />

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="8dp"

                            android:text="@string/diet_plan"

                            android:textColor="@color/text_primary_light"

                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ROW 3 -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">


                <!-- REMINDERS -->

                <com.google.android.material.card.MaterialCardView

                    android:id="@+id/card_reminders"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_margin="8dp"

                    android:layout_weight="1"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="20dp">

                        <ImageView

                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_notifications"

                            app:tint="@color/card_reminders" />

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="8dp"

                            android:text="@string/reminders"

                            android:textColor="@color/text_primary_light"

                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ABOUT US -->

                <com.google.android.material.card.MaterialCardView

                    android:id="@+id/card_about_us"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_margin="8dp"

                    android:layout_weight="1"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

