<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_food_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grilled Chicken Breast"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tv_meal_type_tag"/>

            <TextView
                android:id="@+id/tv_meal_type_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Lunch"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/primary_blue"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_serving_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0 x 100g"
            android:textSize="13sp"
            android:textColor="@color/text_secondary_light"
            android:layout_marginTop="2dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_macro_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P: 31g | C: 0g | F: 3.6g"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/healthy_green"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/tv_calories_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="165 kcal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/healthy_orange"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_data_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source: USDA FDC ID: 171077"
                android:textSize="11sp"
                android:textColor="@color/text_secondary_light"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <ImageButton
                android:id="@+id/btn_delete_food_log"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:rotation="90"
                app:tint="#FF5252"
                android:contentDescription="Delete Entry"/>
        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
